MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1418312813}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8f40da26d3eb4694385c3c2988ecb0ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Historia
  fondo: {fileID: 2800000, guid: 3989637cb483dae489c0573d4cc3a22e, type: 3}
  diapositivas:
  - texto: En lo alto de los Andes, cada solsticio los pueblos celebran el Inti Raymi, la gran fiesta del Sol.
    imagen: {fileID: 2800000, guid: bb638bd5c2204b642a621282c44f1944, type: 3}
    tinte: {r: 0, g: 0, b: 0, a: 0.25}
  - texto: "Los Inti, soles sagrados, guardan la luz de las monta\xF1as y hacen crecer el ma\xEDz de las comunidades."
    imagen: {fileID: 2800000, guid: bb638bd5c2204b642a621282c44f1944, type: 3}
    tinte: {r: 0.3, g: 0.15, b: 0, a: 0.3}
  - texto: "Pero una noche sin luna, los Supay, esp\xEDritus de la oscuridad, robaron los Inti y los escondieron entre las cumbres."
    imagen: {fileID: 2800000, guid: 6bcc81c704d4f6a48bc11e47083825fb, type: 3}
    tinte: {r: 0.15, g: 0, b: 0.25, a: 0.6}
  - texto: "Sin los Inti, el sol se apagar\xE1 para siempre y la fiesta jam\xE1s llegar\xE1."
    imagen: {fileID: 2800000, guid: 6bcc81c704d4f6a48bc11e47083825fb, type: 3}
    tinte: {r: 0.08, g: 0, b: 0.12, a: 0.75}
  - texto: "Entonces despert\xF3 el Diablo Huma, guardi\xE1n de los Andes. Su m\xE1scara de dos caras mira al pasado y al futuro."
    imagen: {fileID: 2800000, guid: 0bf1901408197a74b9463e5760d2c0b1, type: 3}
    tinte: {r: 0.3, g: 0.1, b: 0, a: 0.35}
  - texto: "Con su l\xE1tigo sagrado deber\xE1 vencer a los Supay, recuperar cada Inti y devolver la luz a su pueblo."
    imagen: {fileID: 2800000, guid: 0bf1901408197a74b9463e5760d2c0b1, type: 3}
    tinte: {r: 0.4, g: 0.2, b: 0, a: 0.3}
  musica: {fileID: 8300000, guid: 7ce649aea49007c4c823948b12f50dae, type: 3}
  sonidoLetra: {fileID: 0}
  escenaJuego: Nivel 1
  letrasPorSegundo: 38
